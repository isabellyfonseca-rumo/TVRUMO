    <script>
        /*
         * DADOS FICTÍCIOS PARA TESTE.
         * Substituir pelos dados oficiais quando a fonte estiver integrada.
         */

        const dadosCarteiras = [
            {
                carteira: "Cimento",
                TU: 1250,
                TKU: 845000,
                Carload: 980,
                mensal: [3200, 3800, 4100, 3900, 4442, 5448]
            },
            {
                carteira: "Fertilizantes",
                TU: 1800,
                TKU: 920000,
                Carload: 1100,
                mensal: [2800, 3400, 3600, 4200, 4600, 5100]
            },
            {
                carteira: "Grãos",
                TU: 2200,
                TKU: 1200000,
                Carload: 1500,
                mensal: [3500, 4100, 4500, 4800, 5200, 5900]
            },
            {
                carteira: "Açúcar",
                TU: 1650,
                TKU: 780000,
                Carload: 890,
                mensal: [2900, 3300, 3700, 3900, 4200, 4700]
            },
            {
                carteira: "Líquidos",
                TU: 950,
                TKU: 430000,
                Carload: 620,
                mensal: [1800, 2100, 2300, 2500, 2700, 3000]
            },
            {
                carteira: "Celulose",
                TU: 1400,
                TKU: 690000,
                Carload: 750,
                mensal: [2400, 2800, 3100, 3300, 3700, 4000]
            }
        ];

        const nomesMeses = ["Jan", "Fev", "Mar", "Abr", "Mai", "Jun"];

        let indiceCarteiraAtual = 0;
        let telaAtual = "indicadores";
        let temporizadorPainel = null;

        const TEMPO_CARTEIRA = 10000;
        const TEMPO_PAGINA = 20000;

        function formatarNumero(valor) {
            return Number(valor).toLocaleString("pt-BR");
        }

        function atualizarGrafico(dados) {
            const grafico = document.getElementById("graficoMensal");
            const maiorValor = Math.max(...dados.mensal, 1);

            grafico.innerHTML = dados.mensal.map(function(valor, indice) {
                const altura = Math.max(8, (valor / maiorValor) * 85);

                return `
                    <div class="coluna-grafico">
                        <div class="barra ${indice === dados.mensal.length - 1 ? "destaque" : ""}"
                             style="height:${altura}%;">
                            <span class="valor-barra">${formatarNumero(valor)}</span>
                        </div>
                        <span class="mes-barra">${nomesMeses[indice]}</span>
                    </div>
                `;
            }).join("");

            document.getElementById("tituloGrafico").textContent =
                "Volume mensal — " + dados.carteira;
        }

        function filtrarCarteira(indice) {
            if (indice !== undefined) {
                indiceCarteiraAtual = indice;
            }

            const dados = dadosCarteiras[indiceCarteiraAtual];

            document.getElementById("valorTU").textContent =
                formatarNumero(dados.TU);

            document.getElementById("valorTKU").textContent =
                formatarNumero(dados.TKU);

            document.getElementById("valorCarload").textContent =
                formatarNumero(dados.Carload);

            document.getElementById("tituloTabela").textContent =
                "Indicadores de " + dados.carteira;

            document.getElementById("subtituloTabela").textContent =
                "Detalhamento exclusivo da carteira selecionada.";

            document.getElementById("tabelaCarteira").innerHTML = `
                <tr>
                    <td>Carteira</td>
                    <td>${dados.carteira}</td>
                </tr>
                <tr>
                    <td>Toneladas úteis (TU)</td>
                    <td>${formatarNumero(dados.TU)}</td>
                </tr>
                <tr>
                    <td>Toneladas úteis por quilômetro (TKU)</td>
                    <td>${formatarNumero(dados.TKU)}</td>
                </tr>
                <tr>
                    <td>Carload</td>
                    <td>${formatarNumero(dados.Carload)}</td>
                </tr>
            `;

            document.getElementById("resumoNome").textContent = dados.carteira;
            document.getElementById("resumoTU").textContent = formatarNumero(dados.TU);
            document.getElementById("resumoTKU").textContent = formatarNumero(dados.TKU);
            document.getElementById("resumoCarload").textContent = formatarNumero(dados.Carload);

            document.querySelectorAll(".botao-carteira").forEach(function(botao, indice) {
                botao.classList.toggle("ativo", indice === indiceCarteiraAtual);
            });

            atualizarGrafico(dados);
        }

        function selecionarCarteira(indice) {
            filtrarCarteira(indice);

            if (telaAtual !== "indicadores") {
                const botoesMenu = document.querySelectorAll(".botao-menu");
                mostrarTela("indicadores", botoesMenu[0]);
            } else {
                agendarProximaEtapa();
            }
        }

        function mostrarTela(idTela, botaoClicado) {
            telaAtual = idTela;

            document.querySelectorAll(".tela").forEach(function(tela) {
                tela.classList.toggle("ativa", tela.id === idTela);
            });

            document.querySelectorAll(".botao-menu").forEach(function(botao) {
                botao.classList.remove("ativo");
            });

            if (botaoClicado) {
                botaoClicado.classList.add("ativo");
            }

            agendarProximaEtapa();
        }

        function agendarProximaEtapa() {
            clearTimeout(temporizadorPainel);

            const tempo = telaAtual === "indicadores"
                ? TEMPO_CARTEIRA
                : TEMPO_PAGINA;

            temporizadorPainel = setTimeout(avancarPainel, tempo);
        }

        function avancarPainel() {
            const botoesMenu = document.querySelectorAll(".botao-menu");

            if (telaAtual === "indicadores") {
                if (indiceCarteiraAtual < dadosCarteiras.length - 1) {
                    filtrarCarteira(indiceCarteiraAtual + 1);
                    agendarProximaEtapa();
                } else {
                    mostrarTela("mercado", botoesMenu[1]);
                }
            } else if (telaAtual === "mercado") {
                mostrarTela("noticias", botoesMenu[2]);
            } else {
                filtrarCarteira(0);
                mostrarTela("indicadores", botoesMenu[0]);
            }
        }

        function atualizarRelogio() {
            const agora = new Date();

            document.getElementById("hora").textContent =
                agora.toLocaleTimeString("pt-BR");

            document.getElementById("data").textContent =
                agora.toLocaleDateString("pt-BR", {
                    day: "2-digit",
                    month: "long",
                    year: "numeric"
                });
        }

        atualizarRelogio();
        setInterval(atualizarRelogio, 1000);

        filtrarCarteira(0);
        mostrarTela("indicadores", document.querySelector(".botao-menu"));
    </script>

</body>
